# Voice Bridge 配置示例
# 复制为 .env 后按需修改。所有项都有默认值，只列关键项。

# 手机鉴权 Token（手机 App 设置里要填同样的值）
bridge_token=change-me

# 语音应答时序（秒，从开始识别起算）：
#   <5s 出答案 -> 直接播答案
#   5~7s 出答案 -> 7s 时播 "正在查询，请稍后。" + 答案
#   >7s -> 只播 "正在查询，请稍后。"，答案走轮询补播
agent_interim_seconds=5
agent_grace_deadline_seconds=7

# ASR 模型: tiny / base / small / medium / large-v3（首次使用会下载）
ASR_MODEL=medium

# 任务队列目录（agent 会话从此处领取任务、写回答案）
VOICE_AGENT_TASK_DIR=/tmp/voice-bridge-tasks
